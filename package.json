{
  "name": "dazi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-desktop/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:desktop": "bun scripts/build-desktop.mjs",
    "desktop": "bun run build && bun run build:desktop && electron .",
    "test:electron": "playwright test --config=tests/electron/playwright.config.ts",
    "package:desktop": "bun run build && bun run build:desktop && bun scripts/package-desktop.mjs",
    "test:package": "playwright test --config=tests/package/playwright.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@streamdown/cjk": "1.0.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.24.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "streamdown": "2.7.0",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "electron": "44.9.0",
    "oxfmt": "0.59.0",
    "oxlint": "1.81.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.22.0"
  },
  "packageManager": "bun@1.4.3"
}
